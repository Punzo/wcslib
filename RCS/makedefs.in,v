  CFLAGS  := -pg -a -g -O -Wall -Wno-parentheses -Wno-long-long
  FFLAGS  := -pg -a -g -O -Wimplicit -Wuninitialized -Wno-globals -I.
  LDFLAGS := -pg -a -g $(filter -L%, $(LDFLAGS))
  override EXTRA_CLEAN := gmon.out bb.out
endif


# Solaris with gcc/g77.
