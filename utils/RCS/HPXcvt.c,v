4.17.1.2
log
@Fixed the axis scaling (CDELT1 and CDELT2) in the XPH header, and set the
PCi_ja matrix in the HPX header to a pure 45 degree rotation with
appropriate adjustment of CDELT1 and CDELT2 (matching XPH).  Also set
LONPOLE to 180 deg in the XPH header with adjustment of CRVAL1 as
recommended in the errata.  Modified the FITS header comment for XPH -
it is no longer "experimental".  Also, accept the '-x' option as
equivalent to '-xn'.
@
text
@d25 1
a25 1
  $Id: HPXcvt.c,v 4.17.1.1 2013/01/29 05:32:33 cal103 Exp cal103 $
a138 1
      case '\0':
d755 1
a755 1
  float  cos45, crpix1, crpix2, crval1, crval2, lonpole;
a776 1
  cos45 = (float)sqrt(2.0) / 2.0f;
d778 1
a778 1
    fits_write_key_flt(fptr, "PC1_1",  cos45, -8,
d780 1
a780 1
    fits_write_key_flt(fptr, "PC1_2",  cos45, -8,
d782 1
a782 1
    fits_write_key_flt(fptr, "PC2_1", -cos45, -8,
d784 1
a784 1
    fits_write_key_flt(fptr, "PC2_2",  cos45, -8,
d788 1
a788 1
  cdelt1 = -90.0 / hpxdat->nside / sqrt(2.0);
d841 1
a841 2
    crval1 += 180.0f;
    crval2  =  90.0f;
d843 1
a843 2
    crval1 += 180.0f;
    crval2  = -90.0f;
a844 1
  if (360.0f < crval1) crval1 -= 360.0f;
a850 6
  if (hpxdat->layout) {
    lonpole = 180.0f;
    sprintf(comment, "[deg] Native longitude of the celestial pole", descr1);
    fits_write_key(fptr, TFLOAT, "LONPOLE", &lonpole, comment, &status);
  }

d866 1
a866 1
      "Celestial map with XPH coordinate system (polar HPX) generated by",
@


