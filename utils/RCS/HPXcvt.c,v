*   $Id$
*=============================================================================
*
* HPXcvt reorganises HEALPix data into a 2-D FITS image.  Refer to the usage
* notes below.
*
*---------------------------------------------------------------------------*/

char usage[] =
"Usage: HPXcvt [-c<sys>] [-n|-r] [<infile> [<outfile>]]\n"
"\n"
"HPXcvt reorganises HEALPix data into a 2-D FITS image with HPX coordinate\n"
"system.  The input data may be stored in a FITS file as a primary image\n"
"or image extension, or as a binary table extension.  Both RING and NESTED\n"
"pixel indices are supported.  The input and output files may be omitted or\n"
"specified as \"-\" to indicate stdin and stdout respectively.\n"
"\n"
"Options:\n"
"  -c<sys>      Specify the coordinate system to be used to label the\n"
"               output map if the COORDSYS keyword is absent from the input\n"
"               FITS header.  Recognised values are g (galactic),\n"
"               e (ecliptic) or q (equatorial).\n"
"\n"
"  -n|-r        Assume n(ested) or r(ing) organization if the ORDERING\n"
"               keyword is absent from the input FITS header.\n";

#include <ctype.h>
#include <errno.h>
#include <math.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>

#include <fitsio.h>

#define HEALPIX_NULLVAL (-1.6375e30)

struct healpix {
  char  *infile;	/* Input file.                                */
  char  *outfile;	/* Output file.                               */
  char  crdsys;		/* G(alactic), E(cliptic), or (e)Q(uatorial). */
  char  ordering;	/* R(ing) or N(ested).                        */
  int   nside;		/* Dimension of a base-resolution pixel.      */
  long  npix;		/* Total number of pixels in the data array.  */
  float *data;		/* Pointer to memory allocated to hold data.  */
};

int HEALPixIn(struct healpix *hpxdat);
int HPXout(struct healpix *hpxdat);
int HPXhdr(fitsfile *fptr, struct healpix *hpxdat);
int RINGidx(int nside, long ncoord, int *pixcrd, long *healidx);
int NESTidx(int nside, long ncoord, int *pixcrd, long *healidx);


int main(int argc, char **argv)

{
  int crdsys, i, status;
  struct healpix hpxdat;

  hpxdat.crdsys   = '?';
  hpxdat.ordering = '?';

  /* Parse options. */
  for (i = 1; i < argc && argv[i][0] == '-'; i++) {
    switch (argv[i][1]) {
    case 'c':
      crdsys = toupper(argv[i][2]);
      switch (crdsys) {
      case 'G':
      case 'E':
      case 'Q':
        hpxdat.crdsys = (char)crdsys;
      };
      break;
    case 'n':
      hpxdat.ordering = 'N';
      break;
    case 'r':
      hpxdat.ordering = 'R';
      break;
    default:
      fprintf(stderr, "%s", usage);
      return 1;
    }
  }

  if (i < argc) {
    hpxdat.infile = argv[i++];

    if (i < argc) {
      hpxdat.outfile = argv[i++];

      if (i < argc) {
        fprintf(stderr, "%s", usage);
        return 1;
      }
    } else {
      hpxdat.outfile = "-";
    }
  } else {
    hpxdat.infile = "-";
  }

  /* Check accessibility of the input file. */
  if (strcmp(hpxdat.infile, "-") && access(hpxdat.infile, R_OK) == -1) {
    printf("HPXcvt: Cannot access %s.\n", hpxdat.infile);
    return 1;
  }


  /* Get the HEALPix data as a vector. */
  if ((status = HEALPixIn(&hpxdat))) {
    return 2;
  }

  if (hpxdat.ordering == '?') {
    fprintf(stderr, "WARNING: ORDERING keyword absent, assuming RING.\n");
    hpxdat.ordering = 'r';
  }

  printf("HPXcvt: Read 12 * %d^2  = %ld pixels with %s indexing.\n",
    hpxdat.nside, hpxdat.npix, (hpxdat.ordering == 'N') ? "nested" : "ring");

  /* Map and write it out as a FITS image. */
  if ((status = HPXout(&hpxdat))) return 3;

  if (hpxdat.data) free(hpxdat.data);
  return 0;
}

/*--------------------------------------------------------------------------*/

int HEALPixIn(struct healpix *hpxdat)

{
  char   crdsys[32], ordering[32];
  int    anynul, hdutype, iaxis, irow, nfound, nelem, status;
  long   naxis, *naxes, nrow, nside;
  float    nulval;
  fitsfile *fptr;

  status = 0;
  hpxdat->data = 0x0;

  /* Open the FITS file and move to the first HDU with NAXIS != 0. */
  if (fits_open_data(&fptr, hpxdat->infile, READONLY, &status)) goto fitserr;

  /* Is this the primary HDU or an extension? */
  if (fits_get_hdu_type(fptr, &hdutype, &status)) goto fitserr;
  if (!(hdutype == IMAGE_HDU || hdutype == BINARY_TBL)) {
    fprintf(stderr, "ERROR: %s does not contain HEALPix data.\n",
            hpxdat->infile);
    return 1;
  }


  /* Get the image size. */
  if (fits_read_key_lng(fptr, "NAXIS", &naxis, 0x0, &status)) goto fitserr;
  naxes = malloc(naxis*sizeof(long));
  if (fits_read_keys_lng(fptr, "NAXIS", 1, (int)naxis, naxes, &nfound,
                         &status)) goto fitserr;

  nrow = 0;
  if (hdutype == IMAGE_HDU) {
    /* Look for the first non-degenerate axis. */
    for (iaxis = 0; iaxis < nfound; iaxis++) {
      if (naxes[iaxis] > 1) {
        nrow = naxes[iaxis];
      }
    }
    
  } else if (hdutype == BINARY_TBL) {
    /* Binary tables are simpler. */
    if (nfound > 1) nrow = naxes[1];
  }

  if (!nrow) {
    fprintf(stderr, "ERROR: Could not determine image size.\n");
    goto cleanup;
  }


  /* Number of pixels per side of each base-resolution pixel. */
  nside = 0;
  if (fits_read_key_lng(fptr, "NSIDE", &nside, 0x0, &status)) {
    /* Some HEALPix files, e.g. SFD dust maps, don't record NSIDE. */
    if (status != KEY_NO_EXIST) goto fitserr;
    status = 0;
  }

  if (!nside) {
    /* Deduce NSIDE. */
    nside = (int)(sqrt((double)(nrow / 12)) + 0.5);
  }

  /* Sanity check: total number of pixels must be a multiple of NAXIS2. */
  if ((hpxdat->npix = 12*nside*nside)%nrow != 0) {
    fprintf(stderr, "ERROR: 12*NSIDE*NSIDE is not a multiple of NAXIS2.\n");
    goto cleanup;
  }

  hpxdat->nside = (int)nside;


  /* Any sign of a coordinate system identifier? */
  if (fits_read_key(fptr, TSTRING, "COORDSYS", crdsys, 0x0, &status)) {
    if (status != KEY_NO_EXIST) goto fitserr;
    status = 0;
  } else if (crdsys[0] == 'G') {
    hpxdat->crdsys = 'G';
  } else if (crdsys[0] == 'E') {
    hpxdat->crdsys = 'E';
  } else if (crdsys[0] == 'C') {
    /* ("celestial") */
    hpxdat->crdsys = 'Q';
  }

  /* Ring or nested ordering? */
  if (fits_read_key(fptr, TSTRING, "ORDERING", ordering, 0x0, &status)) {
    if (status != KEY_NO_EXIST) goto fitserr;
    status = 0;

    /* Some HEALPix files, e.g. SFD dust maps, don't record ORDERING. */
    hpxdat->ordering = '?';

  } else if (strcmp(ordering, "RING") == 0) {
    hpxdat->ordering = 'R';

  } else if (strcmp(ordering, "NESTED") == 0) {
    hpxdat->ordering = 'N';

  } else {
    hpxdat->ordering = '?';
    fprintf(stderr, "WARNING: Invalid ORDERING keyword: %s.\n", ordering);
  }


  /* Allocate memory and read the data. */
  if ((hpxdat->data = malloc((hpxdat->npix)*sizeof(float))) == NULL) {
    perror("HPXcvt");
    goto cleanup;
  }

  nulval = HEALPIX_NULLVAL;
  if (hdutype == IMAGE_HDU) {
    if (fits_read_img(fptr, TFLOAT, 1l, nrow, &nulval, hpxdat->data, &anynul,
        &status)) goto fitserr;

  } else if (hdutype == BINARY_TBL) {
    nelem = (hpxdat->npix) / nrow;
    for (irow = 0; irow < nrow; irow++) {
      if (fits_read_col(fptr, TFLOAT, 1l, irow+1, 1l, nelem, &nulval,
          hpxdat->data + irow*nelem, &anynul, &status)) goto fitserr;
    }
  }

  /* Clean up. */
  fits_close_file(fptr, &status);
  status = 0;
  return 0;

fitserr:
  fits_report_error(stderr, status);
cleanup:
  if (hpxdat->data) free(hpxdat->data);
  hpxdat->data = 0x0;
  return 1;
}

/*--------------------------------------------------------------------------*/

int HPXout(struct healpix *hpxdat)

{
  const int I1[] = {0, 0, 1, 2, 3};
  const int J1[] = {0, 1, 2, 3, 4};
  const int I2[] = {2, 3, 4, 5, 5};
  const int J2[] = {1, 2, 3, 4, 5};

  char  history[72];
  int   iband, i, i1, i2, j, j0, j1, j2, nside, *pc, *pixcrd = 0x0, status;
  long  fpixel, *healidx = 0x0, *healp, naxes[2], ncoord, nspan;
  float nulval = HEALPIX_NULLVAL, *row = 0x0, *rowp;
  fitsfile *fptr;

  status = 0;

  nside = hpxdat->nside;
  nspan = 5 * nside;

  /* Create the output FITS file. */
  naxes[0] = nspan;
  naxes[1] = nspan;
  if (fits_create_file(&fptr, hpxdat->outfile, &status)) goto fitserr;
  if (fits_create_img(fptr, FLOAT_IMG, 2, naxes, &status)) goto fitserr;

  /* Write WCS cards. */
  if ((status = HPXhdr(fptr, hpxdat))) goto fitserr;


  /* Allocate arrays. */
  if ((pixcrd  = malloc(3 * nside * sizeof(int[2]))) == NULL ||
      (healidx = malloc(3 * nside * sizeof(long)))    == NULL ||
      (row     = malloc(5 * nside * sizeof(float)))   == NULL) {
    perror("HPXcvt");
    goto cleanup;
  }

  /* Loop band-by-band. */
  j0 = (2 * nside) + 1;
  fpixel = 1;
  for (iband = 0; iband < 5; iband++) {
    /* Set row bounds for this band. */
    i1 = nside * I1[iband];
    i2 = nside * I2[iband];
    j1 = nside * J1[iband];
    j2 = nside * J2[iband];

    /* Number of non-blank pixels in each row of this band. */
    ncoord = i2 - i1;

    /* Loop row-by-row. */
    for (j = j1; j < j2; j++) {
      /* Get HEALPix pixel indices from pixel coordinates. */
      if (hpxdat->ordering == 'N') {
        /* Set pixel coordinates for this row of the output map. */
        pc = pixcrd;
        for (i = i1; i < i2; i++) {
          /* Output pixel coordinates for this row. */
          *(pc++) = i;
          *(pc++) = j;
        }

	/* Transform to nested indices. */
        status = NESTidx(nside, ncoord, pixcrd, healidx);

      } else {
        /* Set pixel coordinates for this row of the output map. */
        pc = pixcrd;
        for (i = i1; i < i2; i++) {
          /* Double-pixelisation pixel coordinates for this row. */
          *(pc++) = nspan - j - i;
          *(pc++) = j0 + j - i;
        }

	/* Transform to ring indices. */
        status = RINGidx(nside, ncoord, pixcrd, healidx);
      }

      /* Gather data into the output vector. */
      rowp = row;
      for (i = 0; i < i1; i++) {
        *(rowp++) = nulval;
      }

      healp = healidx;
      for (i = i1; i < i2; i++) {
        *(rowp++) = hpxdat->data[*(healp++)];
#if 0
*(rowp++) = *(healp++);
#endif
      }

      for (i = i2; i < nspan; i++) {
        *(rowp++) = nulval;
      }

      /* Write out this row. */
      status = 0;
      if (fits_write_imgnull(fptr, TFLOAT, fpixel, nspan, row, &nulval,
                             &status)) {
        goto fitserr;
      }

      fpixel += nspan;
    }
  }

  /* Write history. */
  sprintf(history, "Original input file: %s", hpxdat->infile);
  fits_write_history(fptr, history, &status);
  sprintf(history, "  Original ordering: %s",
    (hpxdat->ordering == 'N') ? "NESTED" : "RING");
  if (hpxdat->ordering == 'r') strcat(history, " (assumed)");
  fits_write_history(fptr, history, &status);


  /* Clean up. */
  fits_close_file(fptr, &status);
  status = 0;
  return 0;

fitserr:
  fits_report_error(stderr, status);
cleanup:
  if (pixcrd)  free(pixcrd);
  if (healidx) free(healidx);
  if (row)     free(row);
  return 1;
}

/*--------------------------------------------------------------------------*/

int HPXhdr(fitsfile *fptr, struct healpix *hpxdat)

{
  int    ival, status;
  float  fval;
  double dval;

  status = 0;

  ival = 0;
  fits_update_key(fptr, TLOGICAL, "EXTEND", &ival,
    "No FITS extensions are present", &status);
  fits_write_date(fptr, &status);

  fval = (5 * hpxdat->nside + 1) / 2.0f;
  fits_write_key(fptr, TFLOAT, "CRPIX1", &fval,
    "Coordinate reference pixel", &status);
  fits_write_key(fptr, TFLOAT, "CRPIX2", &fval,
    "Coordinate reference pixel", &status);

  fval =  0.5f;
  fits_write_key(fptr, TFLOAT, "PC1_1", &fval,
    "Transformation matrix element", &status);
  fval =  0.5f;
