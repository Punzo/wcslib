/*--------------------------------------------------------------------------*/

int RINGidx(int nside, long ncoord, int *pixcrd, long *healidx)

{
  int  i, icoord, j, jpole, jxn, jxs, n2side, n8side, npj, npole, *pc;
  long *hp;

  n2side = 2 * nside;
  n8side = 8 * nside;

  /* Index of the last pixel in the north polar cap. */
  npole = (n2side - 1) * (n2side - 1) - 1;

  /* j-coordinate of the pole. */
  jpole = 4 * nside + 1;

  /* j-coordinate at the transition latitudes. */
  jxs = nside + 1;
  jxn = jxs + n2side;

  pc = pixcrd;
  hp = healidx;
  for (icoord = 0; icoord < ncoord; icoord++, hp++) {
    /* Zero-relative pixel coordinates. */
    i = *(pc++);
    j = *(pc++);

    if (i < 0) i += n8side;

    if (j > jxn) {
      /* North polar regime. */
      if (j == jpole) {
        *hp = 0;
      } else {
        /* Number of pixels in a polar facet with this value of j. */
        npj = 2 * (jpole - j);

        /* Index of the last pixel in the row above this. */
        *hp = (npj - 1) * (npj - 1) - 1;

        /* Number of pixels in this row in the polar facets before this. */
        *hp += npj * (i/n2side);

        /* Pixel number in this polar facet. */
        *hp += i%n2side - (j - jxn) - 1;
      }

    } else if (j >= jxs) {
      /* Equatorial regime. */
      *hp = npole + n8side * (jxn - j) + i;

    } else {
      /* South polar regime. */
      *hp = 24 * nside * nside + 1;

      if (j > 1) {
        /* Number of pixels in a polar facet with this value of j. */
        npj = 2 * (j - 1);

        /* Total number of pixels in this row or below it. */
        *hp -= (npj + 1) * (npj + 1);

        /* Number of pixels in this row in the polar facets before this. */
        *hp += npj * (i/n2side);

        /* Pixel number in this polar facet. */
        *hp += i%n2side - (jxs - j) - 1;
      }
    }

    /* Convert double-pixelisation index to regular. */
    *hp -= 1;
    *hp /= 2;
  }

  return 0;
}

/*--------------------------------------------------------------------------*/

int NESTidx(int nside, long ncoord, int *pixcrd, long *healidx)

{
  const int FACETS[][5] = {{ 6,  9, -1, -1, -1},
                           { 1,  5,  8, -1, -1},
                           {-1,  0,  4, 11, -1},
                           {-1, -1,  3,  7, 10},
                           {-1, -1, -1,  2,  6}};
  int  i, icoord, j, nside2, p2, *pc;
  long *hp;

  nside2 = nside * nside;

  pc = pixcrd;
  hp = healidx;
  for (icoord = 0; icoord < ncoord; icoord++, hp++) {
    /* Zero-relative pixel coordinates. */
    i = *(pc++);
    j = *(pc++);

    /* Pixel index of the first pixel in this facet. */
    *hp = nside2 * FACETS[j/nside][i/nside];

    /* Pixel coordinates relative to the southern corner of this facet. */
    i = nside - i%nside - 1;
    j =         j%nside;

    p2 = 1;
    while (i || j) {
      *hp += p2 * (i%2);
      p2  *= 2;
      *hp += p2 * (j%2);
      p2  *= 2;
      i /= 2;
      j /= 2;
    }
  }

  return 0;
}
