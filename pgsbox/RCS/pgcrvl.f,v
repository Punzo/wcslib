a278 15
      GRID = GRIDSP
      IF (GRID.EQ.0D0) THEN
*        Choose an appropriate grid spacing.
         DLNG = LNG(2) - LNG(1)
         DLAT = LAT(2) - LAT(1)
         GRID = MIN(DLNG, DLAT)/QUANT
         IF (GRID.GE.1D0) THEN
            IF (GRID.LE.1.5D0) THEN
               GRID = 1D0
            ELSE IF (GRID.LT.3D0) THEN
               GRID = 2D0
            ELSE IF (GRID.LT.7D0) THEN
               GRID = 5D0
            ELSE IF (GRID.LT.12D0) THEN
               GRID = 10D0
d280 2
a281 1
               GRID = 15D0
d283 14
d301 23
a323 15
      TMP = AINT(LNG(1)/GRID)*GRID
      IF (TMP.GT.LNG(1)) TMP = TMP - GRID
      LNG(1) = TMP - GRID
      TMP = AINT(LNG(2)/GRID)*GRID
      IF (TMP.LT.LNG(2)) TMP = TMP + GRID
      LNG(2) = TMP + GRID
      
      TMP = AINT(LAT(1)/GRID)*GRID
      IF (TMP.GT.LAT(1)) TMP = TMP - GRID
      LAT(1) = TMP - GRID
      IF (LAT(1).LT.-90D0) LAT(1) = LAT(1) + GRID
      TMP = AINT(LAT(2)/GRID)*GRID
      IF (TMP.LT.LAT(2)) TMP = TMP + GRID
      LAT(2) = TMP + GRID
      IF (LAT(2).GT.+90D0) LAT(2) = LAT(2) - GRID
