d91 12
a102 9
      INTEGER   AXEN(2), IERR, ILAT, ILNG, IPIX, JPIX, NLAT, NLNG, NP,
     *          WCS(0:3)
      REAL      WPIX(4), XR(BUFSIZ), YR(BUFSIZ)
      DOUBLE PRECISION CDELT(2), CEL(10), CRPIX(2), CRVAL(2), DLAT,
     *          DLNG, GRID, GRIDSP, IMGCRD(2), LAT(2), LATPOL, LIN(19),
