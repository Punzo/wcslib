            IF (WORLD(WCS(1)).LT.LNG(1)) LNG(1) = WORLD(WCS(1))
            IF (WORLD(WCS(1)).GT.LNG(2)) LNG(2) = WORLD(WCS(1))
            IF (WORLD(WCS(2)).LT.LAT(1)) LAT(1) = WORLD(WCS(2))
            IF (WORLD(WCS(2)).GT.LAT(2)) LAT(2) = WORLD(WCS(2))
d148 76
a223 2
      IF (LAT(1).LT.-90D0) LAT(1) = -90D0
      IF (LAT(2).GT.+90D0) LAT(2) = +90D0
