      PRJ(8)  = PROJP(8)
      PRJ(9)  = PROJP(9)
      PRJ(10) = 0D0
      PRJ(11) = 0D0

*     Linear transformation coefficients.
      LIN(1)  = 0
      LIN(2)  = 2
      LIN(3)  = 2
