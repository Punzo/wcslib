            CALL WCSFWD (CTYPE, WCS, WORLD, CRVAL, CEL, PHI, THETA,
     *         PRJ, IMGCRD, LIN, PIXCRD, IERR)
*           Ignore IERR for now.

            IF (NP.GT.0) THEN
