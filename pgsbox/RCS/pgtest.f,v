      STATUS = WCSPUT (WCS, WCS_CDELT, 1D-3, 2, 0)

*     Set parameters to draw the native grid.
      STATUS = WCSPUT (WCS, WCS_CRVAL, -45.0D0, 1, 0)
      STATUS = WCSPUT (WCS, WCS_CRVAL, -89.7D0, 2, 0)
