8.5.1.2
log
@PGSBOX now accounts for the possibility that the coordinate system is not
defined outside the frame.  Previously this was important for determining
axis crossings and hence axis labelling.  However, it is not valid for -TAB
coordinates in FITS for which extrapolation is strictly limited to half a
pixel.
@
text
@d22 2
a23 2
* http://www.atnf.csiro.au/computing/software/wcs
* $Id: pgsbox.f,v 8.5.1.1 2025/12/06 14:05:17 mcalabre Exp mcalabre $
d463 3
a465 4
      REAL      BLC(2), BLC_(2), RHO, RTIKLN, S, TAU, TRC(2), TRC_(2),
     :          WXY(4), X1, X2, XPOINT, XR(BUFSIZ), XSCL, XSPAN, xSTEP,
     :          XTOL, XVP1, XVP2, Y1, Y2, YR(BUFSIZ), YSCL, YSPAN,
     :          YSTEP, YTOL, YVP1, YVP2
d470 1
a470 1
     :          WMIN(2), WORLD(9), WRLD(9), XY(9)
a1252 2

*               On the frame is outside; gives a crossing-point.
a1255 77
*               Account for coordinate systems that are not defined
*               outside the frame.
                IF (INSIDE .AND. IWK.GT.0) THEN
*                 If the first point (IWK.EQ.0) is valid and already
*                 inside the frame, then the grid line begins inside
*                 the frame.  However, if there were invalid points
*                 before it (IWK.GT.0) and the first valid point is
*                 already inside the frame then look for a crossing
*                 point.
                  WRLD(J) = WORLD(J)
                  WRLD(K) = WORLD(K) + SW(K)

                  IF (DOLBOX) THEN
                    XY(1) = (WRLD(1) - WXY(1))/XSPAN
                    XY(2) = (WRLD(2) - WXY(3))/YSPAN
                  ELSE
                    CALL NLFUNC (1, NLC, NLI, NLD, NLCPRM, NLIPRM,
     :                NLDPRM, WRLD, XY, CONTRL, CONTXT, IERR)
                  END IF

                  IF (IERR.LE.0) THEN
                    X2 = REAL(XY(1))
                    Y2 = REAL(XY(2))

                    RHO = 999.0
                    XSTEP = X2 - X1
                    YSTEP = Y2 - Y1

                    IF (XSTEP.NE.0.0) THEN
*                     Proximity to left edge of frame.
                      TAU = (X1 - BLC(1)) / XSTEP
                      IF (ABS(TAU).LT.RHO) THEN
                        XY(1) = BLC(1)
                        XY(2) = Y1 - TAU*YSTEP
                        RHO = ABS(TAU)
                      END IF

*                     Proximity to right edge of frame.
                      TAU = (X1 - TRC(1)) / XSTEP
                      IF (ABS(TAU).LT.RHO) THEN
                        XY(1) = TRC(1)
                        XY(2) = Y1 - TAU*YSTEP
                        RHO = ABS(TAU)
                      END IF
                    END IF

                    IF (YSTEP.NE.0.0) THEN
*                     Proximity to bottom edge of frame.
                      TAU = (Y1 - BLC(2)) / YSTEP
                      IF (ABS(TAU).LT.RHO) THEN
                        XY(1) = X1 - TAU*XSTEP
                        XY(2) = BLC(2)
                        RHO = ABS(TAU)
                      END IF

*                     Proximity to top edge of frame.
                      TAU = (Y1 - TRC(2)) / YSTEP
                      IF (ABS(TAU).LT.RHO) THEN
                        XY(1) = X1 - TAU*XSTEP
                        XY(2) = TRC(2)
                        RHO = ABS(TAU)
                      END IF
                    END IF

*                   Check that it really is a crossing point.
                    IF (RHO.LT.3.0) THEN
                      CALL NLFUNC (-1, NLC, NLI, NLD, NLCPRM, NLIPRM,
     :                  NLDPRM, WRLD, XY, CONTRL, CONTXT, IERR)
                      IF (IERR.LE.0) THEN
                        X1 = REAL(XY(1))
                        Y1 = REAL(XY(2))
                        INSIDE = .FALSE.
                      END IF
                    END IF
                  END IF
                END IF

a1277 56
*               Account for coordinate systems that are not defined
*               outside the frame.
                IF (NP.GT.1 .AND. .NOT.GETEND) THEN
*                 Look for a crossing point.
                  RHO = 999.0
                  XSTEP = XR(NP) - XR(NP-1)
                  YSTEP = YR(NP) - YR(NP-1)

                  IF (XSTEP.NE.0.0) THEN
*                   Proximity to left edge of frame.
                    TAU = (BLC(1) - XR(NP)) / XSTEP
                    IF (ABS(TAU).LT.RHO) THEN
                      XY(1) = BLC(1)
                      XY(2) = YR(NP) + TAU*YSTEP
                      RHO = ABS(TAU)
                    END IF

*                   Proximity to right edge of frame.
                    TAU = (TRC(1) - XR(NP)) / XSTEP
                    IF (ABS(TAU).LT.RHO) THEN
                      XY(1) = TRC(1)
                      XY(2) = YR(NP) + TAU*YSTEP
                      RHO = ABS(TAU)
                    END IF
                  END IF

                  IF (YSTEP.NE.0.0) THEN
*                   Proximity to bottom edge of frame.
                    TAU = (BLC(2) - YR(NP)) / YSTEP
                    IF (ABS(TAU).LT.RHO) THEN
                      XY(1) = XR(NP) + TAU*XSTEP
                      XY(2) = BLC(2)
                      RHO = ABS(TAU)
                    END IF

*                   Proximity to top edge of frame.
                    TAU = (TRC(2) - YR(NP)) / YSTEP
                    IF (ABS(TAU).LT.RHO) THEN
                      XY(1) = XR(NP) + TAU*XSTEP
                      XY(2) = TRC(2)
                      RHO = ABS(TAU)
                    END IF
                  END IF

*                 Check that it really is a crossing point.
                  IF (RHO.LT.3.0) THEN
                    CALL NLFUNC (-1, NLC, NLI, NLD, NLCPRM, NLIPRM,
     :                NLDPRM, WRLD, XY, CONTRL, CONTXT, IERR)
                    IF (IERR.LE.0) THEN
                      NP = NP + 1
                      XR(NP) = REAL(XY(1))
                      YR(NP) = REAL(XY(2))
                    END IF
                  END IF
                END IF

