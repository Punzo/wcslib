   wcs.crpix[0] = 192.0;
   wcs.crpix[1] = 640.0;

   /* Rotate 30 degrees. */
   rotn = 30.0*d2r;
   *(wcs.pc)   =  cos(rotn);
   *(wcs.pc+1) =  sin(rotn);
   *(wcs.pc+2) = -sin(rotn);
   *(wcs.pc+3) =  cos(rotn);

