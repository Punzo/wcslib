  gcode[0] = 2;
  gcode[1] = 2;

  /* Draw native grid in green. */
  cpgscr(16, 0.0f, 0.2f, 0.0f);
  /* Title in cyan. */
  cpgscr(17, 0.3f, 1.0f, 1.0f);

