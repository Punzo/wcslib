int wcsutil_dpkey_int(struct dpkey *dp)

{
  if (dp->type != 0) {
    dp->value.i = (int)dp->value.f;
    dp->type = 0;
  }

  return dp->value.i;
}

/*--------------------------------------------------------------------------*/

double wcsutil_dpkey_double(struct dpkey *dp)

{
  if (dp->type == 0) {
    dp->value.f = (double)dp->value.f;
    dp->type = 1;
  }

  return dp->value.f;
@


