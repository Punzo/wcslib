int wcsutil_fletcher32(const uint16_t *data, size_t len)

{
  uint32_t c0, c1;
  for (c0 = c1 = 0; 0 < len; len--) {
    c0 += *data++;
    c1 += c0;
  }

  c0 %= 65535;
  c1 %= 65535;

  return (int)(c1 << 16 | c0);
@


