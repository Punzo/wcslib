log
@Added WCSPRINTF_PTR() macro for printing addresses consistently.
@
text
@d31 1
a31 1
  $Id: wcsprintf.h,v 4.7.1.2 2011/08/09 02:32:16 cal103 Exp cal103 $
a90 10
*
* WCSPRINTF_PTR() macro - Print addresses in a consistent way
* -----------------------------------------------------------
* WCSPRINTF_PTR() is a preprocessor macro used to print addresses in a
* consistent way.  On some systems the "%p" format descriptor when applied to
* a NULL pointer renders the string "0x0".  On others, however, it produces
* "(nil)".  Consistency is required when comparing the output of test
* programs.  The WCSPRINTF_PTR() macro ensures that a NULL pointer is always
* rendered as "0x0".
*
a99 7
#define WCSPRINTF_PTR(str1, ptr, str2) \
  if (ptr) { \
    wcsprintf("%s%p%s", (str1), (void *)(ptr), (str2)); \
  } else { \
    wcsprintf("%s0x0%s", (str1), (str2)); \
  }

@


