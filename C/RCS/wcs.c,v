// : : : : : : : : : : : : : : : : : : : : : : : : : : : : : : : : : : : : : :

static int wcs_chksum(const struct wcsprm *wcs)

{
  if (wcs == 0x0) return WCSERR_NULL_POINTER;

  // data[] is treated as a byte-array.
  uint16_t data[2048];
  uint8_t *datap = (uint8_t *)data;

  size_t  naxis = wcs->naxis;
  size_t    szi = sizeof(int);
  size_t    szd = sizeof(double);
  size_t nszc72 = naxis * sizeof(char [72]);
  size_t   nszd = naxis *  szd;
  size_t  nnszd = naxis * nszd;

  // wcsprm::naxis.
  memcpy(datap, &wcs->naxis, szi);
  datap += szi;

  // wcsprm::crpix[].
  memcpy(datap, wcs->crpix, nszd);
  datap += nszd;

  // wcsprm::pc[].
  memcpy(datap, wcs->pc, nnszd);
  datap += nnszd;

  // wcsprm::cdelt[].
  memcpy(datap, wcs->cdelt, nszd);
  datap += nszd;

  // wcsprm::crval[].
  memcpy(datap, wcs->crval, nszd);
  datap += nszd;

  // wcsprm::cunit[].
  memcpy(datap, wcs->cunit, nszc72);
  datap += nszc72;

  // wcsprm::ctype[].
  memcpy(datap, wcs->ctype, nszc72);
  datap += nszc72;

  // wcsprm::lonpole.
  memcpy(datap, &wcs->lonpole, szd);
  datap += szd;

  // wcsprm::latpole.
  memcpy(datap, &wcs->latpole, szd);
  datap += szd;

  // wcsprm::restfrq.
  memcpy(datap, &wcs->restfrq, szd);
  datap += szd;

  // wcsprm::restwav.
  memcpy(datap, &wcs->restwav, szd);
  datap += szd;

  // wcsprm::npv.
  memcpy(datap, &wcs->npv, szi);
  datap += szi;

  // wcsprm::pv[].
  if (wcs->pv) {
    size_t nszpv = wcs->npvmax * sizeof(struct pvcard);
    memcpy(datap, &wcs->pv, nszpv);
    datap += nszpv;
  }

  // wcsprm::nps.
  memcpy(datap, &wcs->nps, szi);
  datap += szi;

  // wcsprm::ps[].
  if (wcs->ps) {
    size_t nszps = wcs->npsmax * sizeof(struct pscard);
    memcpy(datap, &wcs->ps, nszps);
    datap += nszps;
  }

  // wcsprm::cd.
  if (wcs->cd) {
    memcpy(datap, wcs->pc, nnszd);
    datap += nnszd;
  }

  // wcsprm::crota[].
  if (wcs->crota) {
    memcpy(datap, wcs->crota, nszd);
    datap += nszd;
  }

  // wcsprm::altlin.
  memcpy(datap, &wcs->altlin, szi);
  datap += szi;

  // wcsprm::ntab.
  memcpy(datap, &wcs->ntab, szi);
  datap += szi;

  // wcsprm::nwtb.
  memcpy(datap, &wcs->nwtb, szi);
  datap += szi;

  // wcsprm::tab (an address).
  size_t szp = sizeof(struct tabprm *);
  memcpy(datap, &wcs->tab, szp);
  datap += szp;

  // wcsprm::wtb (an address).
  szp = sizeof(struct wtbarr *);
  memcpy(datap, &wcs->wtb, szp);
  datap += szp;

  // Count of 16-bit words.
  size_t len = ((uint16_t *)datap - data);

  return wcsutil_fletcher32(data, len);
@


