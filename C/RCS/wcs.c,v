int time_type(const char *ctype)

{
  // Is it a recognised time system as listed in Table 2 of WCS Paper VII?
  if (strcmp(ctype, "UTC")) return 1;
  if (strcmp(ctype, "TAI")) return 1;
  if (strcmp(ctype, "IAT")) return 1;
  if (strcmp(ctype, "TT"))  return 1;
  if (strcmp(ctype, "TDB")) return 1;
  if (strcmp(ctype, "TDT")) return 1;
  if (strcmp(ctype, "GPS")) return 1;
  if (strcmp(ctype, "TCB")) return 1;
  if (strcmp(ctype, "TCG")) return 1;
  if (strcmp(ctype, "GMT")) return 1;
  if (strcmp(ctype, "UT1")) return 1;
  if (strcmp(ctype, "UT"))  return 1;
  if (strcmp(ctype, "ET"))  return 1;
  if (strcmp(ctype, "LOCAL")) return 1;

  return 0;
