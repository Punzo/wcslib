/*----------------------------------------------------------------------------
*   Determine the number of coordinate representations (up to 27) and the
*   table columns associated with in each, and count the number of TVn_ma and
*   TSn_ma cards in each representation.
*---------------------------------------------------------------------------*/

void wcsbth_naxes(int n, int k, char a, int alts[], int colalt[], int *npptr)

{
  /* During the first pass alts[] is used to determine the number of        */
  /* coordinate representations (up to 27).                                 */
  /*                                                                        */
  /* colalt[] is used as a 2-D bit array of dimension (1+NCOL) * 27 which   */
  /* records the table columns that are associated with WCS keywords with   */
  /* an "a" descriptor.  At the end of the first pass this is used by       */
  /* wcsbth_inits() to determine the number of coordinate axes in each      */
  /* representation and the corresponding table column numbers.             */

  int iax, ncols;

  iax = 0;
  if (a != ' ') {
    iax = a - 'A' + 1;
  }

  alts[iax] = 1;

  ncols = colalt[0];

  if (0 < n && n <= ncols) {
    colalt[n] |= (1 << iax);
  }

  if (0 < k && k <= ncols) {
    colalt[k] |= (1 << iax);
  }

  if (npptr) {
    npptr[iax]++;
  }
}


/*----------------------------------------------------------------------------
*   Allocate memory for an array of the required number of wcsprm structs and
*   initialize each of them.
*---------------------------------------------------------------------------*/

int wcsbth_inits(
  int colalt[],
  int npv[],
  int nps[],
  int *nwcs,
  struct wcsprm **wcs,
  int alts[])

{
  int iax, icol, ix, mask, ncols, npsmax, npvmax, status = 0;
  struct wcsprm *wcsp;

  /* Find the number of coordinate representations. */
  *nwcs = 0;
  for (iax = 0; iax < 27; iax++) {
    if (alts[iax]) {
      (*nwcs)++;
    }
  }

  if (*nwcs) {
    /* Allocate memory for the required number of wcsprm structs. */
    if (!(*wcs = calloc(*nwcs, sizeof(struct wcsprm)))) {
      return 2;
    }

    /* Record the current values of NPVMAX and NPSMAX. */
    npvmax = wcsnpv(-1);
    npsmax = wcsnps(-1);

    /* Determine the number of axes in each coordinate representation. */
    ncols = colalt[0];
    for (iax = 0, mask = 1; iax < 27; iax++, mask <<= 1) {
      if (alts[iax]) {
        alts[iax] = 0;
        for (icol = 1; icol <= ncols; icol++) {
          if (colalt[icol] & mask) {
            alts[iax]++;
          }
        }
      }
    }

    /* Initialize each wcsprm struct. */
    wcsp = *wcs;
    *nwcs = 0;
    for (iax = 0; iax < 27; iax++) {
      if (alts[iax]) {
        wcsp->flag = -1;
        wcsnpv(npv[iax]);
        wcsnps(nps[iax]);
        if ((status = wcsini(1, alts[iax], wcsp))) {
          wcsvfree(nwcs, wcs);
          break;
        }

        /* Record the alternate version code. */
        if (iax) {
          wcsp->alt[0] = 'A' + iax - 1;
        }

        /* Record the table column numbers. */
        mask = (1 << iax);
        for (icol = 1, ix = 0; icol <= ncols; icol++) {
          if (colalt[icol] & mask) {
            wcsp->colax[ix++] = icol;
          }
        }

        /* In the second pass alts[] indexes the array of wcsprm structs. */
        alts[iax] = (*nwcs)++;

        wcsp++;
      }
    }

    /* Restore the original values of NPVMAX and NPSMAX. */
    wcsnpv(npvmax);
    wcsnps(npsmax);
  }

  return status;
}


/*----------------------------------------------------------------------------
*   Return the axis number associated with the specified column number in a
*   particular coordinate representation.
*---------------------------------------------------------------------------*/

int wcsbth_colax(struct wcsprm **wcs, int alts[], int n, char a)

{
  int ix;
  struct wcsprm *wcsp;

  wcsp = *wcs;
  if (a != ' ') {
    wcsp += alts[a-'A'+1];
  }

  for (ix = 0; ix < wcsp->naxis; ix++) {
    if (wcsp->colax[ix] == n) {
      return ++ix;
    }
  }

  return 0;
}


/*----------------------------------------------------------------------------
*   Interpret any VELREF cards encountered for each coordinate representation.
*---------------------------------------------------------------------------*/

int wcsbth_final(
  int alts[],
  double epoch[],
  int velref[],
  double vsource[],
  int *nwcs,
  struct wcsprm **wcs)

{
  static char *specsys[] = {"LSRK", "BARYCENT", "TOPOCENT",
                            "LSRD", "GEOCENTR", "SOURCE", "GALACTOC"};
  int iax, ivf, status;
  double beta, c = 299792458.0;

  for (iax = 0; iax < *nwcs; iax++) {
    /* Check for EPOCH overriding EQUINOXa. */
    if (undefined((*wcs+iax)->equinox) && !undefined(epoch[iax])) {
      /* Set EQUINOXa. */
      (*wcs+iax)->equinox = epoch[iax];
    }

    /* Check for VELREF overriding SPECSYSa. */
    if (velref[iax]) {
      /* Set SPECSYSa. */
      if ((*wcs+iax)->specsys[0] == '\0') {
        ivf = velref[iax]%256 - 1;
        if (0 <= ivf && ivf < 7) {
          sprintf((*wcs+iax)->specsys, "%s", specsys[ivf]);
        }
      }
    }

    /* Check for VSOURCEa overriding ZSOURCEa. */
    if (undefined((*wcs+iax)->zsource) && !undefined(vsource[iax])) {
      /* Convert relativistic Doppler velocity to redshift. */
      beta = vsource[iax]/c;
      (*wcs+iax)->zsource = (1.0+beta)/sqrt(1.0 - beta*beta) - 1.0;
    }

    /* Interpret -TAB header cards. */
    if ((status = wcstab(*wcs+iax))) {
       wcsvfree(nwcs, wcs);
       return status;
    }
  }

  return 0;
}
