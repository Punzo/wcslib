                 strcmp(dis->dtype[j], "Polynomial*") == 0) {
        /* General polynomial distortion. */
        /* >>> TBD <<< */
      }

      if (dis->disx2p[j] == 0x0) continue;
      /* >>> TBD <<< */

    }
  }

