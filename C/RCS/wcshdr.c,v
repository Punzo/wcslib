  sip2tpd = 0;
  if ((dis = wcs->lin.dispre) && strcmp(dis->dtype[0], "SIP") == 0) {
    /* Simple Imaging Polynomial (SIP); was it permuted by wcssub()? */
    if (strcmp(wcs->ctype[0], "RA---TAN-SIP") ||
        strcmp(wcs->ctype[1], "DEC--TAN-SIP")) {
      /* Yes.  Native SIP doesn't have axis mapping so use TPD. */
      sip2tpd = 1;

    } else {
      /* SIP is handled by translating its dpkey records.             */
      /* Determine a suitable numerical precision for the polynomial  */
      /* coefficients to avoid trailing zeroes common to all of them. */
      keyp = dis->dp;
      kp = keyvalue + 3;
      for (idp = 0; idp < dis->ndp; idp++, keyp++) {
        fp = strpbrk(keyp->field, ".") + 1;
        if (strncmp(fp, "SIP.", 4) != 0) continue;
        wcsutil_double2str(keyvalue, "%20.13E", keyp->value.f);
        while (*kp != '0' && *kp != 'E') kp++;
      }

      precision = kp - keyvalue - 3;
      if (precision < 1)  precision = 1;
      if (13 < precision) precision = 13;
      sprintf(format, "%%20.%dE", precision);

      /* Ensure the coefficients are written in a human-readable sequence. */
      for (j = 1; j <= 2; j++) {
        /* Distortion function polynomial coefficients. */
        wcshdo_util(relax, "", "", 0, 0x0, 0, 0, 0, ' ', 0, 0, "", "",
          nkeyrec, header, &status);

        if (j == 1) {
          strcpy(keyword, "A_");
        } else {
          strcpy(keyword, "B_");
        }

        ncoeff = dis->iparm[j-1][3];
        for (degree = 0; degree <= 9; degree++) {
          if (ncoeff <= nTPD[degree]) break;
        }

        strcpy(keyword+2, "ORDER");
        sprintf(keyvalue, "%20d", degree);
        sprintf(comment, "SIP polynomial degree, axis %d, pixel-to-sky", j);
        wcshdo_util(relax, keyword, "", 0, 0x0, 0, 0, 0, alt, 0, 0,
          keyvalue, comment, nkeyrec, header, &status);

        keyp = dis->dp;
        for (idp = 0; idp < dis->ndp; idp++, keyp++) {
          if (keyp->j != j) continue;
          fp = strpbrk(keyp->field, ".") + 1;

          if (strncmp(fp, "SIP.FWD.", 8) != 0) continue;
          strcpy(keyword+2, fp+8);

          wcsutil_double2str(keyvalue, format, keyp->value.f);
          wcshdo_util(relax, keyword, "", 0, 0x0, 0, 0, 0, alt, 0, 0,
            keyvalue, "SIP distortion polynomial coefficient", nkeyrec,
            header, &status);
        }

        strcpy(keyword+2, "MAX");
        wcsutil_double2str(keyvalue, "%20.3f", dis->maxdis[j-1]);
        wcshdo_util(relax, keyword, "", 0, 0x0, 0, 0, 0, alt, 0, 0,
          keyvalue, "Maximum value of distortion function", nkeyrec,
          header, &status);
      }

      for (j = 1; j <= 2; j++) {
        /* Inverse distortion function polynomial coefficients. */
        wcshdo_util(relax, "", "", 0, 0x0, 0, 0, 0, ' ', 0, 0, "", "",
          nkeyrec, header, &status);

        if (j == 1) {
          strcpy(keyword, "AP_");
        } else {
          strcpy(keyword, "BP_");
        }

        ncoeff = dis->iparm[j-1][2] - dis->iparm[j-1][3];
        for (degree = 0; degree <= 9; degree++) {
          if (ncoeff <= nTPD[degree]) break;
        }

        strcpy(keyword+3, "ORDER");
        sprintf(keyvalue, "%20d", degree);
        sprintf(comment, "SIP polynomial degree, axis %d, sky-to-pixel", j);
        wcshdo_util(relax, keyword, "", 0, 0x0, 0, 0, 0, alt, 0, 0,
          keyvalue, comment, nkeyrec, header, &status);

        keyp = dis->dp;
        for (idp = 0; idp < dis->ndp; idp++, keyp++) {
          if (keyp->j != j) continue;
          fp = strpbrk(keyp->field, ".") + 1;

          if (strncmp(fp, "SIP.REV.", 8) != 0) continue;
          strcpy(keyword+3, fp+8);

          wcsutil_double2str(keyvalue, format, keyp->value.f);
          wcshdo_util(relax, keyword, "", 0, 0x0, 0, 0, 0, alt, 0, 0,
            keyvalue, "SIP inverse polynomial coefficient",
            nkeyrec, header, &status);
        }
      }
    }
  }


  for (idis = 0; idis < 2; idis++) {
    if (idis == 0 && (dis = wcs->lin.dispre) == 0x0) continue;
    if (idis == 1 && (dis = wcs->lin.disseq) == 0x0) continue;

    for (j = 0; j < naxis; j++) {
      if (dis->disp2x[j] == 0x0) continue;

      /* Identify the distortion type. */
      if (strcmp(dis->dtype[j], "TPV") == 0) {
        /* TPV "projection" is handled by translating its dpkey records, */
        /* which were originally translated from PVi_ma by wcsset().     */
        /* Determine a suitable numerical precision for the polynomial   */
        /* coefficients to avoid trailing zeroes common to all of them.  */
        keyp = dis->dp;
        kp = keyvalue + 3;
        for (idp = 0; idp < dis->ndp; idp++, keyp++) {
          fp = strpbrk(keyp->field, ".") + 1;
          if (strncmp(fp, "TPV.", 4) != 0) continue;
          wcsutil_double2str(keyvalue, "%20.13E", keyp->value.f);
          while (*kp != '0' && *kp != 'E') kp++;
        }

        precision = kp - keyvalue - 3;
        if (precision < 1)  precision = 1;
        if (13 < precision) precision = 13;
        sprintf(format, "%%20.%dE", precision);

        wcshdo_util(relax, "", "", 0, 0x0, 0, 0, 0, ' ', 0, 0, "", "",
          nkeyrec, header, &status);

        /* Distortion function polynomial coefficients. */
        sprintf(keyword, "PV%d_", j+1);
        kp = keyword + strlen(keyword);

        keyp = dis->dp;
        for (idp = 0; idp < dis->ndp; idp++, keyp++) {
          if (keyp->j != j+1) continue;
          fp = strpbrk(keyp->field, ".") + 1;

          if (strncmp(fp, "TPV.", 4) != 0) continue;
          strcpy(kp, fp+4);

          /* Identify the term of the TPV polynomial for human readers. */
          sscanf(fp+4, "%d", &m);
          for (degree = 0; degree <= 9; degree++) {
            if (m < nTPD[degree]) break;
          }

          if (degree == 0) {
            strcpy(tpdterm, "1");

          } else {
            k = degree - (m - nTPD[degree-1]);

            if (k < 0) {
              strncpy(tpdterm, "rrrrrrrrr", degree);
            } else if (j == wcs->lng) {
              strncpy(tpdterm, "xxxxxxxxx", k);
              strncpy(tpdterm+k, "yyyyyyyyy", degree-k);
            } else {
              strncpy(tpdterm, "yyyyyyyyy", k);
              strncpy(tpdterm+k, "xxxxxxxxx", degree-k);
            }

            tpdterm[degree] = '\0';
          }

          sprintf(comment, "TPV distortion coefficient: %s", tpdterm);

          wcsutil_double2str(keyvalue, format, keyp->value.f);
          wcshdo_util(relax, keyword, "", 0, 0x0, 0, 0, 0, alt, 0, 0,
            keyvalue, comment, nkeyrec, header, &status);
        }

      } else if (sip2tpd || strcmp(dis->dtype[j], "TPD") == 0) {
        /* Template Polynomial Distortion. */
