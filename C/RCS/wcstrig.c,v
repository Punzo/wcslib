4.3.1.3
log
@Added a wrapper for sincosd() - following Michael Droettboom's patch.
@
text
@d31 1
a31 1
  $Id: wcstrig.c,v 4.3.1.2 2009/07/22 04:28:39 cal103 Exp cal103 $
a87 34
void sincosd(double angle, double *s, double *c)

{
  double resid;

  if (fmod(angle,90.0) == 0.0) {
    resid = fmod(angle,360.0);
    if (resid == 0.0) {
      *s =  0.0;
      *c =  1.0;
    } else if (resid == 90.0) {
      *s =  1.0;
      *c =  0.0;
    } else if (resid == 180.0) {
      *s =  0.0;
      *c = -1.0;
    } else if (resid == 270.0) {
      *s = -1.0;
      *c =  0.0;
    }
  } else {
#ifdef HAVE_SINCOS
    sincos(angle*D2R, s, c);
#else
    *s = sin(angle*D2R);
    *c = cos(angle*D2R);
#endif
  }

  return;
}

/*--------------------------------------------------------------------------*/

