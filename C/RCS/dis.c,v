int dispoly(
  const int ip[],
  const double p[],
  int Nhat,
  const double rawcrd[],
  double *discrd)

{
  int    jhat, k, K, m, M, nKparm, nparm;
  const double *cptr, *pptr;
  double *aux, auxp0, term;

  nparm  = ip[1];
  K      = ip[3];
  M      = ip[4];
  nKparm = ip[5];

  /* Check for zeroes. */
  for (jhat = 0; jhat < Nhat; jhat++) {
    if (rawcrd[jhat] == 0.0) {
      *discrd = 0.0;
      return 0;
    }
  }

  /* Working memory was allocated at the end of p[]. */
  aux = (double *)(p + nparm);

  /* Compute the auxiliary variables. */
  for (k = 0; k < K; k++) {
    cptr = p + k*nKparm;
    pptr = cptr + (1+Nhat);

    aux[k] = *(cptr++);
    auxp0  = *(pptr++);

    for (jhat = 0; jhat < Nhat; jhat++) {
      aux[k] += *(cptr++)*pow(rawcrd[jhat], *(pptr++));
    }

    aux[k] = pow(aux[k], auxp0);

    /* Check for zeroes. */
    if (aux[k] == 0.0) {
      *discrd = 0.0;
      return 0;
    }
  }

  /* Loop for each term of the polynomial. */
  *discrd = 0.0;
  pptr = p + K*nKparm;
  for (m = 0; m < M; m++) {
    term = *(pptr++);

    /* Loop over the independent variables. */
    for (jhat = 0; jhat < Nhat; jhat++) {
      term *= pow(rawcrd[jhat], *(pptr++));
    }

    /* Loop over the auxiliary variables. */
    for (k = 0; k < K; k++) {
      term *= pow(aux[k], *(pptr++));
    }

    *discrd += term;
  }

  return 0;
}


