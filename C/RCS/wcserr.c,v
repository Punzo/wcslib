#include <stdarg.h>
#include <stdio.h>
#include <string.h>
#include "wcserr.h"

void wcserr_ini(
  struct wcserr *err)

{
  memset(err, 0, sizeof(struct wcserr));
}

int wcserr_copy(
  struct wcserr* dst,
  const struct wcserr* src)

{
  memcpy(dst, src, sizeof(struct wcserr));
  return dst->status;
}

int wcserr_set(
  struct wcserr *err,
  int status,
  const char *source_file,
  int line_no,
  const char *format,
  ...)

{
  va_list argp;

  if (err == 0x0) {
    return status;
  }
  
  err->status = status;

  va_start(argp, format);
  vsnprintf(err->msg, WCSERR_MESSAGE_LENGTH, format, argp);
  va_end(argp);

  strncpy(err->source_file, source_file, 80);
  err->line_no = line_no;

  return status;
}
