int speclog(dummy, nspec, sspec, sloge, spec, loge, stat)

double dummy;
int nspec, sspec, sloge;
const double spec[];
double loge[];
int stat[];

{
   int status = 0;
   register int ispec, *statp;
   register const double *specp;
   register double *logep;

   specp = spec;
   logep = loge;
   statp = stat;
   for (ispec = 0; ispec < nspec; ispec++) {
      if (*specp > 0.0) {
         *logep = log(*specp);
         *(statp++) = 0;
      } else {
         *(statp++) = 1;
         status = 4;
      }

      specp += sspec;
      logep += sloge;
   }

   return status;
}

