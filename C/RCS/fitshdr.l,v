int fitshdr(
  const char header[],
  int nkeyrec,
  int nkeyids,
  struct fitskeyid keyids[],
  int *nreject,
  struct fitskey **keys)

{
  int status;
  yyscan_t yyscanner;
  int yylex_init(yyscan_t *yyscanner);
  int yylex_destroy(yyscan_t yyscanner);

  yylex_init(&yyscanner);
  status = fitshdr_scanner(header, nkeyrec, nkeyids, keyids, nreject,
                           keys, yyscanner);
  yylex_destroy(yyscanner);

  return status;
}

