int dssfwd(phi, theta, prj, x, y)
 
const double phi, theta;
struct prjprm *prj;
double *x, *y;
 
{
   int iter;
   double deta, detadx, detady, dx, dxi, dxidx, dxidy, dy;
   double eta, eta0, r, r4, rr, s, xi, xi0, xo, xx, xy, yo, yy, z;
   const double tol = 1.0e-12;

   if (abs(prj->flag) != PRJSET) {
      if (dssset(prj)) return 1;
   }

   /* Apply forward gnomonic projection to get standard coordinates. */
   s = sind(theta);
   if (s == 0.0) {
      return 2;
   }
 
   r =  prj->w[0]*cosd(theta)/s;
   xi0  =  r*sind(phi);
   eta0 = -r*cosd(phi);

   /* Initial guess for plate offsets (in mm). */
   xo =  (xi0 - prj->p[3])/prj->p[1];
   yo = (eta0 - prj->p[23])/prj->p[21];

   /* Iterate. */
   for (iter = 0; iter < 100; iter++) {
      xx = xo*xo;
      yy = yo*yo;
      xy = xo*yo;
      rr = xx + yy;
      r4 = rr*rr;

      xi =     xo*r4*prj->p[13] +
               xy*(prj->p[5]  + xo*prj->p[9]   + yo*prj->w[6])   +
               yo*(prj->p[2]  + yo*(prj->w[4]  + yo*prj->p[11])) +
               xo*(prj->p[1]  + xo*(prj->w[3]  + xo*prj->w[5]))  +
               prj->p[3];

      /* Derivative of xi wrt x. */
      dxidx =  xy*prj->w[11]  + rr*(4.0*xx + rr)*prj->p[13] +
               yo*(prj->p[5]  + yo*prj->w[6])  +
               xo*(prj->w[7]  + xo*prj->w[9])  +
               prj->p[1];

      /* Derivative of xi wrt y. */
      dxidy =  xy*(prj->w[10] + rr*prj->w[13]) +
               xo*(prj->p[5]  + xo*prj->p[9])  +
               yo*(prj->w[8]  + yo*prj->w[12]) +
               prj->p[2];

      eta =    yo*r4*prj->p[33] +
               xy*(prj->p[25] + yo*prj->p[29]  + xo*prj->w[17])  +
               xo*(prj->p[22] + xo*(prj->w[15] + xo*prj->p[31])) +
               yo*(prj->p[21] + yo*(prj->w[14] + yo*prj->w[16])) +
               prj->p[23];

      /* Derivative of eta wrt x. */
      detadx = xy*(prj->w[21] + rr*prj->w[24]) +
               yo*(prj->p[25] + yo*prj->p[29]) +
               xo*(prj->w[19] + xo*prj->w[23]) +
               prj->p[22];

      /* Derivative of eta wrt y. */
      detady = xy*prj->w[22]  + rr*(4.0*yy + rr)*prj->p[33] +
               xo*(prj->p[25] + xo*prj->w[17]) +
               yo*(prj->w[18] + yo*prj->w[20]) +
               prj->p[21];

      /* Error terms. */
      dxi   =  xi0 - xi;
      deta  = eta0 - eta;

      /* Compute correction. */
      z  = dxidx*detady - dxidy*detadx;
      dx = (dxi*detady - deta*dxidy)/z;
      dy = (deta*dxidx - dxi*detadx)/z;

      /* Apply correction. */
      xo = xo + dx;
      yo = yo + dy;

      /* Test for convergence. */
      if (fabs(dx) < tol) {
         if (fabs(dy) < tol) break;
      }
   }

   /* Convert plate centre offsets from mm to degrees. */
   *x = xo/prj->w[1];
   *y = yo/prj->w[2];
 
   if (prj->flag == PRJSET && s < 0.0) {
      return 2;
   }
 
   return 0;
}
 
/*--------------------------------------------------------------------------*/
 
int dssrev(x, y, prj, phi, theta)
 
const double x, y;
struct prjprm *prj;
double *phi, *theta;
 
{
   double eta, r, r4, rr, xi, xo, xx, xy, yo, yy;

   if (abs(prj->flag) != PRJSET) {
      if (dssset(prj)) return 1;
   }

   /* Convert plate centre offsets from degrees to mm. */
   xo = x*prj->w[1];
   yo = y*prj->w[2];

   xx = xo*xo;
   yy = yo*yo;
   xy = xo*yo;
   rr = xx + yy;
   r4 = rr*rr;

   /* Convert to standard coordinates in arcsec. */
   xi =  xo*r4*prj->p[13] +
         xy*(prj->p[5]  + xo*prj->p[9]   + yo*prj->w[6])   +
         yo*(prj->p[2]  + yo*(prj->w[4]  + yo*prj->p[11])) +
         xo*(prj->p[1]  + xo*(prj->w[3]  + xo*prj->w[5]))  +
         prj->p[3];
   eta = yo*r4*prj->p[33] +
         xy*(prj->p[25] + yo*prj->p[29]  + xo*prj->w[17])  +
         xo*(prj->p[22] + xo*(prj->w[15] + xo*prj->p[31])) +
         yo*(prj->p[21] + yo*(prj->w[14] + yo*prj->w[16])) +
         prj->p[23];

   /* Apply reverse gnomonic projection. */
   r = sqrt(xi*xi + eta*eta);
   if (r == 0.0) {
      *phi = 0.0;
   } else {
      *phi = atan2d(xi, -eta);
   }
   *theta = atan2d(prj->w[0], r);
 
