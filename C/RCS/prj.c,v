//----------------------------------------------------------------------------

int prjsize(const struct prjprm *prj, int sizes[2])

{
  if (prj == 0x0) {
    sizes[0] = sizes[1] = 0;
    return PRJERR_SUCCESS;
  }

  // Base size, in bytes.
  sizes[0] = sizeof(struct prjprm);

  // Total size of allocated memory, in bytes.
  sizes[1] = 0;

  int exsizes[2];

  // prjprm::err.
  wcserr_size(prj->err, exsizes);
  sizes[1] += exsizes[0] + exsizes[1];

  return PRJERR_SUCCESS;
@


