/*============================================================================
*   DSS: Digitized Sky Survey plate solution.
*
*   Given:
*      prj->p[1]   AMDX1  (= a1)
*      prj->p[2]   AMDX2  (= a2)
*      prj->p[3]   AMDX3  (= a3)
*      prj->p[4]   AMDX4  (= a4)
*      prj->p[5]   AMDX5  (= a5)
*      prj->p[6]   AMDX6  (= a6)
*      prj->p[7]   AMDX7  (= a7)
*      prj->p[8]   AMDX8  (= a8)
*      prj->p[9]   AMDX9  (= a9)
*      prj->p[10]  AMDX10 (= a10)
*      prj->p[11]  AMDX11 (= a11)
*      prj->p[12]  AMDX12 (= a12)
*      prj->p[13]  AMDX13 (= a13)
*                 (AMDX14 to AMDX20 are reserved but not used)
*      prj->p[21]  AMDY1  (= b1)
*      prj->p[22]  AMDY2  (= b2)
*      prj->p[23]  AMDY3  (= b3)
*      prj->p[24]  AMDY4  (= b4)
*      prj->p[25]  AMDY5  (= b5)
*      prj->p[26]  AMDY6  (= b6)
*      prj->p[27]  AMDY7  (= b7)
*      prj->p[28]  AMDY8  (= b8)
*      prj->p[29]  AMDY9  (= b9)
*      prj->p[30]  AMDY10 (= b10)
*      prj->p[31]  AMDY11 (= b11)
*      prj->p[32]  AMDY12 (= b12)
*      prj->p[33]  AMDY13 (= b13)
*                 (AMDY14 to AMDY20 are reserved but not used)
*
*   Given and/or returned:
*      prj->r0     r0; reset to 180/pi if 0.
*      prj->w[0]   3600*r0
*      prj->w[1]   3600.0/a1  ...x plate scale, mm/degree.
*      prj->w[2]   3600.0/b1  ...y plate scale, mm/degree.
*      prj->w[3]   a4  + a7
*      prj->w[4]   a6  + a7
*      prj->w[5]   a8  + a12
*      prj->w[6]   a10 + a12
*      prj->w[7]   2*(a4  + a7)
*      prj->w[8]   2*(a6  + a7)
*      prj->w[9]   3*(a8  + a12)
*      prj->w[10]  2*(a10 + a12)
*      prj->w[11]  2*a9
*      prj->w[12]  3*a11
*      prj->w[13]  4*a13
*      prj->w[14]  b4  + b7
*      prj->w[15]  b6  + b7
*      prj->w[16]  b8  + b12
*      prj->w[17]  b10 + b12
*      prj->w[18]  2*(b4  + b7)
*      prj->w[19]  2*(b6  + b7)
*      prj->w[20]  3*(b8  + b12)
*      prj->w[21]  2*(b10 + b12)
*      prj->w[22]  2*b9
*      prj->w[23]  3*b11
*      prj->w[24]  4*b13
*===========================================================================*/
 
int dssset(prj)
 
struct prjprm *prj;
 
{
   if (prj->r0 == 0.0) {
      prj->r0 = R2D;
   }
 
   if (prj->p[1] == 0.0 || prj->p[21] == 0.0) {
      return 1;
   }

   prj->w[0]  = 3600.0*prj->r0;
   prj->w[1]  = 3600.0/prj->p[1];
   prj->w[2]  = 3600.0/prj->p[21];
   prj->w[3]  = prj->p[4]  + prj->p[7];
   prj->w[4]  = prj->p[6]  + prj->p[7];
   prj->w[5]  = prj->p[8]  + prj->p[12];
   prj->w[6]  = prj->p[10] + prj->p[12];
   prj->w[7]  = 2.0*prj->w[3];
   prj->w[8]  = 2.0*prj->w[4];
   prj->w[9]  = 3.0*prj->w[5];
   prj->w[10] = 2.0*prj->w[6];
   prj->w[11] = 2.0*prj->p[9];
   prj->w[12] = 3.0*prj->p[11];
   prj->w[13] = 4.0*prj->p[13];
   prj->w[14] = prj->p[24] + prj->p[27];
   prj->w[15] = prj->p[26] + prj->p[27];
   prj->w[16] = prj->p[28] + prj->p[32];
   prj->w[17] = prj->p[30] + prj->p[32];
   prj->w[18] = 2.0*prj->w[14];
   prj->w[19] = 2.0*prj->w[15];
   prj->w[20] = 3.0*prj->w[16];
   prj->w[21] = 2.0*prj->w[17];
   prj->w[22] = 2.0*prj->p[29];
   prj->w[23] = 3.0*prj->p[31];
   prj->w[24] = 4.0*prj->p[33];
 
   prj->flag = PRJSET;
 
   return 0;
}
 
