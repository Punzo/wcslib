      SUBROUTINE PGBEG2 (UNIT, FILE, NXSUB, NYSUB)
      INTEGER   NXSUB, NYSUB, UNIT
      CHARACTER FILE*80

      CALL PGBEG (UNIT, FILE, NXSUB, NYSUB)

      RETURN
      END

*-----------------------------------------------------------------------

      SUBROUTINE PGTXT2 (X, Y, TEXT)
      REAL      X, Y
      CHARACTER TEXT*80

      CALL PGTEXT (X, Y, TEXT)

      RETURN
      END
