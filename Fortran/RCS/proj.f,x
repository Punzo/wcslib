*-----------------------------------------------------------------------
      SUBROUTINE TSCFWD (PHI, THETA, PRJ, X, Y, IERR)
*-----------------------------------------------------------------------
      INTEGER   FACE, IERR
      DOUBLE PRECISION COSTHE, L, M, N, PHI, PRJ(0:20), RHO, THETA, TOL,
     *          X, X0, XF, Y, Y0, YF

      PARAMETER (TOL = 1D-12)

