      IF (ABS(YF).GT.1D0) THEN
         IF (ABS(YF).GT.1D0+TOL) THEN
            IERR = 2
            RETURN
         END IF
         YF = SIGN(1D0,YF)
      END IF

      X = PRJ(12)*(XF + X0)
      Y = PRJ(12)*(YF + Y0)

      IERR = 0
      RETURN
      END

