*   WCSEX tests closure of WCSFWD and WCSREV.
d209 3
a211 18
*      CTYPE    C()*8    Coordinate axis types.
*      CRVAL    D()      Coordinate reference values.
*
*   Given and returned:
*      CEL      D(10)    Coordinate transformation parameters.
*      PRJ      D(0:20)  Projection parameters.
*      LIN      D()      Linear transformation parameters.
*-----------------------------------------------------------------------
      INTEGER   IERR, J, LAT, LNG, WCS(0:3)
      DOUBLE PRECISION CEL(10), CRVAL(*), DLAT, DLATMX, DLNG, DLNGMX,
     *          IMG1(4), IMG2(4), LAT1, LIN(*), LNG1, PHI1, PHI2,
     *          PIX(4), PRJ(0:20), THETA1, THETA2, TOL, WORLD(4)
      CHARACTER CTYPE(*)*8, PCODE*3
*-----------------------------------------------------------------------
      WCS(0)  = 0
      CEL(5)  = 0D0
      PRJ(10) = 0D0
      PRJ(11) = 0D0
d213 14
a226 2
      DLNGMX = 0D0
      DLATMX = 0D0
d228 3
a230 4
*     Find the projection code.
      CALL WCSSET (NINT(LIN(3)), CTYPE, WCS, IERR)
      PCODE = CTYPE(WCS(1))(6:8)

a233 2
      DO 80 LAT = 90, -90, -1
         LAT1 = DBLE(LAT)
d235 16
a250 2
         DO 70 LNG = -180, 180
            LNG1 = DBLE(LNG)
d252 4
a255 15
            WORLD(1) = 0D0
            WORLD(2) = 0D0
            WORLD(3) = 0D0
            WORLD(4) = 0D0
            WORLD(WCS(1)) = LNG1
            WORLD(WCS(2)) = LAT1

            CALL WCSFWD (CTYPE, WCS, WORLD, CRVAL, CEL, PHI1, THETA1,
     *         PRJ, IMG1, LIN, PIX, IERR)
            IF (IERR.NE.0) THEN
               WRITE (6, 20) PCODE, LNG1, LAT1, IERR
 20            FORMAT (A3,': LNG1 =',F20.15,'  LAT1 =',F20.15,
     *            '  error',I3)
               GO TO 70
            END IF
d257 28
a284 8
            CALL WCSREV (CTYPE, WCS, PIX, LIN, IMG2, PRJ, PHI2, THETA2,
     *         CRVAL, CEL, WORLD, IERR)
            IF (IERR.NE.0) THEN
               WRITE (6, 30) PCODE, LNG1, LAT1, IERR
 30            FORMAT (8X,A3,': LNG1 =',F20.15,'  LAT1 =',F20.15,/,
     *                 '  Error',I3)
               GO TO 70
            END IF
d286 1
a286 4
            DLNG = ABS(WORLD(WCS(1))-LNG1)
            IF (DLNG.GT.180D0) DLNG = ABS(DLNG-360D0)
            IF (ABS(LAT).NE.90 .AND. DLNG.GT.DLNGMX) DLNGMX = DLNG
            DLAT = ABS(WORLD(WCS(2))-LAT1)
d290 12
a301 12
     *         (DLNG.GT.TOL .AND. ABS(LAT).NE.90)) THEN
               WRITE (6, 40) PCODE, LNG1, LAT1, WORLD(WCS(1)),
     *            WORLD(WCS(2))
 40            FORMAT (8X,A3,': LNG1 =',F20.15,'    LAT1 =',F20.15,/,
     *                 8X,'     LNG2 =',F20.15,'    LAT2 =',F20.15)
               WRITE (6, 50) PHI1, THETA1, PHI2, THETA2
 50            FORMAT (8X,'     PHI1 =',F20.15,'  THETA1 =',F20.15,/,
     *                 8X,'     PHI2 =',F20.15,'  THETA2 =',F20.15)
               WRITE (6, 60) IMG1(WCS(1)), IMG1(WCS(2)), IMG2(WCS(1)),
     *                       IMG2(WCS(2))
 60            FORMAT (8X,'       X1 =',F20.15,'    Y1 =',F20.15,/,
     *                 8X,'       X2 =',F20.15,'    Y2 =',F20.15)
a302 2
 70      CONTINUE
 80   CONTINUE
d304 48
a351 2
      WRITE (6, 90) DLNGMX, DLATMX
 90   FORMAT (13X,'Maximum residual (sky): LNG',1P,G10.3,'   LAT',G10.3)
d353 4
d358 12
a369 3
      DO 100 J = 0, 20
         PRJ(J) = 0D0
 100  CONTINUE
@


